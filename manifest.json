{
  "manifest_version": 3,
  "name": "Élő feliratfordító (auto → magyar)",
  "version": "0.2.0",
  "description": "Élő felirat kiolvasása bármely oldalról, azonnali fordítás DeepL-lel a választott nyelvre, mozgatható lebegő ablakban, menthető átirattal.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Élő feliratfordító",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "commands": {
    "toggle-window": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Fordítóablak mutatása / elrejtése"
    },
    "toggle-capture": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Rögzítés indítása / leállítása"
    }
  }
}
